set -e

PACKAGE=twist
VERSION=0.1

echo "Bootstrapping $PACKAGE $VERSION..."

# Check for required tools
for tool in autoconf automake; do
    if ! command -v $tool > /dev/null 2>&1; then
        echo "Error: $tool is required but not found."
        echo "Please install GNU autoconf and GNU automake."
        exit 1
    fi
done

# Create build-aux directory if it doesn't exist
mkdir -p build-aux

# Generate aclocal.m4
echo "Generating aclocal.m4..."
aclocal --install || {
    echo "Error: aclocal failed."
    exit 1
}

# Generate configure script
echo "Generating configure script..."
autoconf || {
    echo "Error: autoconf failed."
    exit 1
}

# Generate Makefile.in files
echo "Generating Makefile.in files..."
automake --add-missing --copy || {
    echo "Error: automake failed."
    exit 1
}

echo ""
echo "Bootstrap complete. Configure with:"
echo "  ./configure --with-quickstep=../quickstep"
echo "  make"
echo "  make install"
