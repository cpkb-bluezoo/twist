# (at your option) any later version.

set -e

cd "$(dirname "$0")"
mkdir -p build-aux
autopoint --force
libtoolize --copy --force
aclocal -I m4
autoheader
autoconf
automake --add-missing --copy
echo "Bootstrap complete. Configure with:"
echo "  ./configure --with-quickstep=../quickstep"
echo "  make"
echo "  make check"
