# Keep what a build in the checkout left behind out of the image build
# context: the image configures and builds from a clean tree (./bootstrap
# regenerates everything below).  A checkout made by CI has none of it.
**/.git
**/.github
**/.claude
/security-review
/autom4te.cache
/aclocal.m4
/configure
/configure~
/configure.lineno
/config.h
/config.h.in
/config.h.in~
/config.cache
/config.log
/config.status
/libtool
/stamp-h1
/twist.pc
/build-aux
/ABOUT-NLS
/m4/*
!/m4/tw_cflags.m4
/po/*
!/po/POTFILES.in
!/po/LINGUAS
!/po/Makevars
!/po/*.po
**/Makefile
**/Makefile.in
**/.deps
**/.libs
**/.dirstamp
**/*.o
**/*.lo
**/*.la
**/*.a
**/*.so
**/*.so.*
**/*.dylib
**/*.gcda
**/*.gcno
**/*.log
**/*.trs
/test-suite.log
/src/twist
/tests/test-*
!/tests/test-*.c
/fuzz-build
/doc/*.info
/doc/*.info-*
/doc/stamp-vti
/doc/version.texi
/twist-*.tar.*
/twist-[0-9]*
**/.DS_Store
