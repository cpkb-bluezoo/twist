# automake --add-missing may drop a generic INSTALL.  The Twist INSTALL
# at the repository root is maintained by hand and stays tracked.
Makefile.in

# m4 files: keep only our own macros.  The rest are copied by autopoint
# and libtoolize.
/m4/*
!/m4/tw_cflags.m4

# gettext files copied in by autopoint or generated by xgettext
/po/*
!/po/POTFILES.in
!/po/LINGUAS
!/po/Makevars
!/po/*.po

