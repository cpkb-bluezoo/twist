# The origin for bench.py: HTTP/1.1, HTTP/2 and HTTP/3 on one port (TCP and
# UDP), files to download from a directory of memory, and PUT to a directory
# of memory.  Filled in by bench.py.
daemon off;
worker_processes 1;
pid @WORK@/nginx.pid;
error_log @WORK@/error.log warn;

events {
    worker_connections 4096;
}

http {
    access_log off;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    gzip off;
    keepalive_timeout 120s;
    keepalive_requests 1000000;
    http2_max_concurrent_streams 1000;
    client_body_temp_path @WORK@/tmp;
    client_max_body_size 0;
    client_body_buffer_size 1m;
    types { }
    default_type application/octet-stream;

    ssl_certificate @WORK@/cert.pem;
    ssl_certificate_key @WORK@/key.pem;
    ssl_protocols TLSv1.3;
    ssl_session_tickets off;
    ssl_prefer_server_ciphers off;

    server {
        listen 127.0.0.1:@PORT@ ssl;
        listen 127.0.0.1:@PORT@ quic reuseport;
        http2 on;
        http3 on;
        quic_retry off;
        server_name localhost;

        location /www/ {
            root @WORK@;
        }
        location /up/ {
            root @WORK@;
            dav_methods PUT;
            create_full_put_path on;
            dav_access user:rw;
        }
    }
}
